{
  "name": "airux",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "check": "biome check . && pnpm typecheck && pnpm test",
    "db:lint": "supabase db lint --local --level error --fail-on error",
    "db:migration:new": "supabase migration new",
    "db:reset": "supabase db reset --local",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "typecheck": "tsc --build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "supabase": "2.113.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
