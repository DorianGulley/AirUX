{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "airux-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "AIRUX_ENVIRONMENT": "local",
    "AIRUX_APP_ORIGIN": "http://127.0.0.1:8787",
    "SUPABASE_URL": "http://127.0.0.1:54321",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH"
  },
  "secrets": {
    "required": [
      "SUPABASE_SECRET_KEY",
      "STREAM_SIGNING_JWK",
      "STREAM_SIGNING_KEY_ID",
      "STREAM_WEBHOOK_SECRET"
    ]
  },
  "stream": {
    "binding": "STREAM"
  },
  "assets": {
    "directory": "../web/public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": []
  },
  "ratelimits": [
    {
      "name": "REVIEWER_AUTH_RATE_LIMITER",
      "namespace_id": "742091001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "CREDENTIAL_CREATE_RATE_LIMITER",
      "namespace_id": "742091002",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "AGENT_REVIEW_CREATE_RATE_LIMITER",
      "namespace_id": "742091003",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "env": {
    "production": {
      "name": "airux-prod",
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": false
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 0.05
        }
      },
      "triggers": {
        "crons": ["*/15 * * * *"]
      },
      "vars": {
        // Deployment scripts replace every value below from the protected
        // GitHub production environment. The invalid Supabase defaults keep a
        // direct Wrangler deployment isolated from any hosted database.
        "AIRUX_ENVIRONMENT": "production",
        "AIRUX_APP_ORIGIN": "https://airux-prod.airux-platform.workers.dev",
        "SUPABASE_URL": "https://configuration.invalid",
        "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_configuration_required"
      },
      "secrets": {
        "required": [
          "SUPABASE_SECRET_KEY",
          "STREAM_SIGNING_JWK",
          "STREAM_SIGNING_KEY_ID",
          "STREAM_WEBHOOK_SECRET"
        ]
      },
      "stream": {
        "binding": "STREAM"
      },
      "ratelimits": [
        {
          "name": "REVIEWER_AUTH_RATE_LIMITER",
          "namespace_id": "742091001",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "CREDENTIAL_CREATE_RATE_LIMITER",
          "namespace_id": "742091002",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "AGENT_REVIEW_CREATE_RATE_LIMITER",
          "namespace_id": "742091003",
          "simple": { "limit": 10, "period": 60 }
        }
      ]
    }
  }
}
